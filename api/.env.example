# Copie para .env e preencha. O .env nunca vai para o git.
NODE_ENV=development
HOST=127.0.0.1
PORT=4100
APP_URL=http://localhost:4100
# Banco PostgreSQL. No computador, pglite:data/pg roda um Postgres embutido (nada para instalar).
# Em produção: postgres://blogsim:SENHA@127.0.0.1:5432/blogsim
DATABASE_URL=pglite:data/pg

# Assina os links de visualização e clique dos anúncios. Em produção, gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRACK_SECRET=

# SMTP da Hostinger. Sem SMTP_PASS os e-mails não saem: ficam só em /dev/emails.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=naoresponda@blogsim.com.br
SMTP_PASS=
MAIL_FROM=BlogSim <naoresponda@blogsim.com.br>

# Fora de produção, e-mail de verdade só sai para estes domínios/endereços; o resto fica simulado em /dev/emails.
MAIL_ONLY_TO=blogsim.com.br

# Quem recebe o aviso de cadastro novo para aprovar.
ADMIN_NOTIFY_EMAIL=

# Só em desenvolvimento: aceita a verificação do script sem visitar o blog (os blogs de exemplo não existem).
DEV_FAKE_SCRIPT_CHECK=true

# Senhas das contas de QA criadas pelo npm run seed.
QA_ADMIN_PASSWORD=
QA_ANUNCIANTE_PASSWORD=
QA_BLOGUEIRO_PASSWORD=