{
  "name": "blogsim-api",
  "version": "0.1.0",
  "private": true,
  "description": "API do BlogSim: contas, aprovação, blogs, campanhas, saldo, saques, medição dos anúncios e e-mails.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.js",
    "start": "node --env-file-if-exists=.env src/main.js",
    "seed": "node --env-file-if-exists=.env src/db/seed.js",
    "report:daily": "node --env-file-if-exists=.env src/jobs/daily-report.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "mail:test": "node --env-file-if-exists=.env src/jobs/mail-test.js",
    "admin:create": "node --env-file-if-exists=.env src/jobs/create-admin.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.7",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13"
  }
}
